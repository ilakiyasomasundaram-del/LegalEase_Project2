generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  COMPLETED
}

model Document {
  id        String         @id @default(cuid())
  title     String
  type      String
  inputData String
  content   String
  status    DocumentStatus @default(COMPLETED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}